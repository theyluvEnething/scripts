#!/bin/zsh
# One line per run in ~/Library/Logs/power-log.log: battery percent, the battery's raw charge, its
# power in watts (negative while discharging), charger, lid, lid sleep, and the apps that used the
# most energy over the last two seconds, by the Energy Impact column of top and Activity Monitor.
# A gap between lines means the Mac was asleep. launchd runs this every 5 minutes (see install.sh).
log="$HOME/Library/Logs/power-log.log"

# The plist form of ioreg gives InstantAmperage signed (negative while discharging); macOS 27
# dropped AppleRawCurrentCapacity, and the charge in mAh now sits under BatteryData.
battery="$(ioreg -r -n AppleSmartBattery -a)"
root="$(ioreg -r -n IOPMrootDomain -d 1 -a)"
value() { print -r -- "$1" | plutil -extract "0.$2" raw -o - - 2>/dev/null; }

percent="$(pmset -g batt | grep -oE '[0-9]+%' | head -1)"
raw="$(value "$battery" BatteryData.RemainingCapacity)/$(value "$battery" BatteryData.FullChargeCapacity) mAh"
watts="$(printf '%+.1f W' $(( $(value "$battery" Voltage) * $(value "$battery" InstantAmperage) / 1e6 )))"
charger="$([ "$(value "$battery" ExternalConnected)" = true ] && echo charger || echo battery)"
lid="$([ "$(value "$root" AppleClamshellState)" = true ] && echo "lid closed" || echo "lid open")"
lidsleep="$([ "$(value "$root" SleepDisabled)" = true ] && echo "lid sleep off" || echo "lid sleep on")"
# top cuts names at 16 characters, so take its PIDs and ask ps for the full name; skip top itself.
apps=""
count=0
top -l 2 -s 2 -n 9 -o power -stats pid,power | awk '/^PID/ { n++; next } n == 2 && NF == 2' |
  while read -r pid power; do
    name="$(ps -o comm= -p "$pid")"
    name="${name##*/}"
    { [ -z "$name" ] || [ "$name" = top ] || [ $count -ge 8 ]; } && continue
    apps="${apps:+$apps, }$name $power"
    count=$((count + 1))
  done

# Past 2 MB, keep the newest half.
if [ -f "$log" ] && [ "$(stat -f %z "$log")" -gt 2000000 ]; then
  tail -c 1000000 "$log" | tail -n +2 > "$log.tmp" && mv "$log.tmp" "$log"
fi
print -r -- "$(date '+%Y-%m-%d %H:%M')  $percent  $raw  $watts  $charger  $lid  $lidsleep  | $apps" >> "$log"
